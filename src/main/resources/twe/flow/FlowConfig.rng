<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <!--
    Editor-assist schema only.
    This file is intentionally permissive and is not the source of truth for
    runtime flow validation. The Scala parser defines actual supported behavior.
  -->

  <start>
    <ref name="FlowConfig"/>
  </start>

  <!--
    Root element. The flow index (index.xml) lists modules, while each module
    file (about-you.xml, income.xml, etc.) defines a single page. Both share the
    FlowConfig root, so it accepts a mix of <module> and <page> children.
  -->
  <define name="FlowConfig">
    <element name="FlowConfig">
      <oneOrMore>
        <choice>
          <ref name="module"/>
          <ref name="page"/>
        </choice>
      </oneOrMore>
    </element>
  </define>

  <define name="module">
    <element name="module">
      <attribute name="src">
        <data type="anyURI"/>
      </attribute>
    </element>
  </define>

  <define name="page">
    <element name="page">
      <attribute name="title">
        <text/>
      </attribute>
      <attribute name="route">
        <data type="token"/>
      </attribute>
      <zeroOrMore>
        <choice>
          <element name="section">
            <ref name="BlockContent"/>
          </element>
          <ref name="modal-dialog"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <!--
    The condition/operator pair gates whether a node is shown. When present, both
    attributes appear together, so they are grouped as a single optional unit.
  -->
  <define name="conditionAttrs">
    <optional>
      <group>
        <attribute name="condition">
          <data type="anyURI"/>
        </attribute>
        <attribute name="operator">
          <ref name="operatorValue"/>
        </attribute>
      </group>
    </optional>
  </define>

  <define name="operatorValue">
    <choice>
      <value>isTrue</value>
      <value>isFalse</value>
      <value>isZero</value>
      <value>isGreaterThanZero</value>
      <value>isIncomplete</value>
      <value>isIncompleteOrFalse</value>
      <value>isTrueAndComplete</value>
      <value>notHasValue</value>
    </choice>
  </define>

  <!--
    Block-level content shared by <section>, <div>, <fg-collection>, <fg-detail>
    and modal content. Items may appear in any order and repeat.
  -->
  <define name="BlockContent">
    <zeroOrMore>
      <choice>
        <ref name="p"/>
        <ref name="heading-elements"/>
        <ref name="ul"/>
        <ref name="ol"/>
        <ref name="div"/>
        <ref name="table"/>
        <ref name="fg-set"/>
        <ref name="fg-alert"/>
        <ref name="fg-collection"/>
        <ref name="fg-detail"/>
        <ref name="fg-withholding-adjustments"/>
      </choice>
    </zeroOrMore>
  </define>

  <define name="heading-elements">
    <choice>
      <ref name="h2"/>
      <ref name="h3"/>
      <ref name="h4"/>
      <ref name="h5"/>
    </choice>
  </define>

  <define name="HeadingAttributes">
    <ref name="conditionAttrs"/>
    <ref name="InlineContent"/>
    <optional>
      <attribute name="class">
        <text/>
      </attribute>
    </optional>
    <optional>
      <attribute name="id">
        <text/>
      </attribute>
    </optional>
  </define>

  <define name="h2">
    <element name="h2">
      <ref name="HeadingAttributes"/>
      <text/>
    </element>
  </define>

  <define name="h3">
    <element name="h3">
      <ref name="HeadingAttributes"/>
      <text/>
    </element>
  </define>

  <define name="h4">
    <element name="h4">
      <ref name="HeadingAttributes"/>
      <text/>
    </element>
  </define>

  <define name="h5">
    <element name="h5">
      <ref name="HeadingAttributes"/>
      <text/>
    </element>
  </define>

  <define name="p">
    <element name="p">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <ref name="conditionAttrs"/>
      <ref name="InlineContent"/>
    </element>
  </define>

  <define name="div">
    <element name="div">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <ref name="conditionAttrs"/>
      <ref name="BlockContent"/>
    </element>
  </define>

  <define name="ul">
    <element name="ul">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <ref name="conditionAttrs"/>
      <oneOrMore>
        <ref name="li"/>
      </oneOrMore>
    </element>
  </define>

  <define name="ol">
    <element name="ol">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <ref name="conditionAttrs"/>
      <oneOrMore>
        <ref name="li"/>
      </oneOrMore>
    </element>
  </define>

  <define name="li">
    <element name="li">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <ref name="conditionAttrs"/>
      <ref name="InlineContent"/>
    </element>
  </define>

  <define name="table">
    <element name="table">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <optional>
        <element name="caption">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <ref name="InlineContent"/>
        </element>
      </optional>
      <optional>
        <element name="thead">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <oneOrMore>
            <ref name="tr"/>
          </oneOrMore>
        </element>
      </optional>
      <oneOrMore>
        <element name="tbody">
          <oneOrMore>
            <ref name="tr"/>
          </oneOrMore>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="tr">
    <element name="tr">
      <ref name="conditionAttrs"/>
      <oneOrMore>
        <choice>
          <element name="th">
            <optional>
              <attribute name="scope">
                <choice>
                  <value>row</value>
                  <value>col</value>
                </choice>
              </attribute>
            </optional>
            <ref name="InlineContent"/>
          </element>
          <element name="td">
            <ref name="InlineContent"/>
          </element>
        </choice>
      </oneOrMore>
    </element>
  </define>

  <!--
    Inline (phrasing) content: free text mixed with inline elements. Shared by
    headings, paragraphs, list items, table cells, questions, hints, etc.
  -->
  <define name="InlineContent">
    <mixed>
      <zeroOrMore>
        <choice>
          <element name="strong">
            <ref name="InlineContent"/>
          </element>
          <element name="span">
            <optional>
              <attribute name="class">
                <text/>
              </attribute>
            </optional>
            <ref name="conditionAttrs"/>
            <ref name="InlineContent"/>
          </element>
          <element name="a">
            <attribute name="href">
              <text/>
            </attribute>
            <optional>
              <attribute name="class">
                <text/>
              </attribute>
            </optional>
            <optional>
              <attribute name="target">
                <value>_blank</value>
              </attribute>
            </optional>
            <ref name="InlineContent"/>
          </element>
          <ref name="fg-show"/>
          <ref name="modal-link"/>
        </choice>
      </zeroOrMore>
    </mixed>
  </define>

  <!-- Renders the value at the given fact path inline. -->
  <define name="fg-show">
    <element name="fg-show">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
    </element>
  </define>

  <define name="modal-link">
    <element name="modal-link">
      <attribute name="for">
        <data type="anyURI"/>
      </attribute>
      <ref name="conditionAttrs"/>
      <ref name="InlineContent"/>
    </element>
  </define>

  <define name="modal-dialog">
    <element name="modal-dialog">
      <attribute name="id">
        <text/>
      </attribute>
      <element name="modal-heading">
        <ref name="InlineContent"/>
      </element>
      <element name="modal-content">
        <ref name="BlockContent"/>
      </element>
    </element>
  </define>

  <!--
    A single fact question/answer. <if-true>/<if-false> gate visibility on a
    boolean fact. Children (question, hint, modal-link, input) are interleaved
    because authors place modal-link before or after the input.
  -->
  <define name="fg-set">
    <element name="fg-set">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
      <optional>
        <choice>
          <attribute name="if-true">
            <data type="anyURI"/>
          </attribute>
          <attribute name="if-false">
            <data type="anyURI"/>
          </attribute>
        </choice>
      </optional>
      <optional>
        <attribute name="optional">
          <value>true</value>
        </attribute>
      </optional>
      <interleave>
        <element name="question">
          <ref name="InlineContent"/>
        </element>
        <optional>
          <element name="hint">
            <optional>
              <attribute name="id">
                <text/>
              </attribute>
            </optional>
            <ref name="conditionAttrs"/>
            <ref name="InlineContent"/>
          </element>
        </optional>
        <optional>
          <ref name="modal-link"/>
        </optional>
        <ref name="input"/>
      </interleave>
    </element>
  </define>

  <define name="input">
    <element name="input">
      <attribute name="type">
        <choice>
          <value>boolean</value>
          <value>date</value>
          <value>dollar</value>
          <value>enum</value>
          <value>int</value>
          <value>single-checkbox</value>
        </choice>
      </attribute>
      <optional>
        <attribute name="options-path">
          <data type="anyURI"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="hintId">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="previous-years">
          <data type="integer"/>
        </attribute>
      </optional>
      <zeroOrMore>
        <element name="option">
          <attribute name="value">
            <data type="token"/>
          </attribute>
          <ref name="InlineContent"/>
        </element>
      </zeroOrMore>
    </element>
  </define>

  <!-- Repeats its inner fg-sets for each item in the collection at @path. -->
  <define name="fg-collection">
    <element name="fg-collection">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
      <ref name="BlockContent"/>
    </element>
  </define>

  <!-- Collapsible disclosure: a summary followed by block content. -->
  <define name="fg-detail">
    <element name="fg-detail">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="icon">
          <text/>
        </attribute>
      </optional>
      <ref name="conditionAttrs"/>
      <element name="summary">
        <ref name="InlineContent"/>
      </element>
      <ref name="BlockContent"/>
    </element>
  </define>

  <define name="fg-alert">
    <element name="fg-alert">
      <attribute name="alert-type">
        <choice>
          <value>info</value>
          <value>warning</value>
          <value>success</value>
          <value>error</value>
          <value>emergency</value>
        </choice>
      </attribute>
      <ref name="conditionAttrs"/>
      <element name="heading">
        <ref name="InlineContent"/>
      </element>
      <oneOrMore>
        <ref name="p"/>
      </oneOrMore>
    </element>
  </define>

  <!--
    Renders withholding-adjustment guidance for a W-4 or W-4P form, gated on a
    boolean fact, using the assignment collection at @path.
  -->
  <define name="fg-withholding-adjustments">
    <element name="fg-withholding-adjustments">
      <attribute name="form-type">
        <choice>
          <value>w-4</value>
          <value>w-4p</value>
        </choice>
      </attribute>
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
      <optional>
        <attribute name="if-true">
          <data type="anyURI"/>
        </attribute>
      </optional>
    </element>
  </define>

</grammar>
